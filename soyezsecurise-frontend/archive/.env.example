# Leave unset for local demo mode. Set before npm run build for the connected feed.
VITE_ARCHIVE_API_URL=https://api.soyezsecurise.com/archive/flashes

# Additional authenticated hosts (comma-separated hostnames; subdomains included).
# Keep in sync with ARCHIVE_PROTECTED_HOSTS on the backend for custom domains.
VITE_ARCHIVE_PROTECTED_HOSTS=
