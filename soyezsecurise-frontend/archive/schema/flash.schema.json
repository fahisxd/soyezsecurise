          ]
        },
        "html": {
          "type": "string",
          "maxLength": 200000,
          "minLength": 1
        },
        "css": {
          "type": "string",
          "maxLength": 100000
        },
        "javascript": {
          "type": "string",
          "maxLength": 100000
        },
        "externalHosts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connect": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^https://[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?(?::[0-9]{1,5})?$"
              }
            },
            "script": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^https://[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?(?::[0-9]{1,5})?$"
              }
            },
            "image": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
