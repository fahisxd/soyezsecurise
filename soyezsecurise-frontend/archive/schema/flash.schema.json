{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "$ref": "#/definitions/v1"
    },
    {
      "$ref": "#/definitions/v2"
    }
  ],
  "definitions": {
    "v1": {
      "title": "THE ARCHIVE flash, version 1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "type": {
          "enum": [
            "historical-incident",
            "vulnerability",
            "malware-history",
            "security-research",
            "meme",
            "security-fact"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "category": {
          "enum": [
            "incidents",
            "vulnerabilities",
            "malware",
            "research",
            "memes",
            "facts"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "media": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "image"
              },
              "url": {
                "type": "string",
                "pattern": "^(https://[^\\s]+|media/[a-zA-Z0-9_./-]+)$",
                "maxLength": 2048
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "kind",
              "url",
              "alt"
            ]
          }
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "front": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1400
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 700
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  }
                },
                "required": [
                  "heading",
                  "body"
                ]
              },
              "back": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1400
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 700
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  }
                },
                "required": [
                  "heading",
                  "body"
                ]
              }
            },
            "required": [
              "front",
              "back"
            ]
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2048
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "required": [
              "title",
              "url"
            ]
          }
        },
        "eventDate": {
          "type": "string",
          "format": "date"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            }
          },
          "required": [
            "name"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "rejected"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "sample",
                "editorial",
                "original-research"
              ]
            },
            "origin": {
              "enum": [
                "manual",
                "monday"
              ]
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "origin"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "reviewedBy",
            "reviewedAt"
          ]
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visual"
          ],
          "properties": {
            "visual": {
              "enum": [
                "memory-leak",
                "network",
                "timeline",
                "bit-flip",
                "terminal",
                "typography",
                "disclosure",
                "entropy"
              ]
            },
            "accent": {
              "enum": [
                "sage",
                "coral",
                "amber",
                "ice"
              ]
            },
            "displayText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "type",
        "title",
        "description",
        "category",
        "slides",
        "author",
        "status",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            }
          },
          "then": {
            "properties": {
              "publishedAt": {},
              "review": {}
            },
            "required": [
              "publishedAt",
              "review"
            ]
          }
        }
      ]
    },
    "v2": {
      "title": "Archive HTML flash, version 2",
      "type": "object",
      "additionalProperties": false,
      "properties": {
