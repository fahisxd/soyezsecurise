          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "type": {
          "enum": [
            "historical-incident",
            "vulnerability",
            "malware-history",
            "security-research",
            "meme",
            "security-fact"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "category": {
          "enum": [
            "incidents",
            "vulnerabilities",
            "malware",
            "research",
            "memes",
            "facts"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "url": {
                "type": "string",
                "format": "uri",
