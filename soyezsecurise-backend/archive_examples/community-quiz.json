  "html": "<main><h1>Which address belongs to example.com?</h1><button data-answer=\"yes\">login.example.com</button><button data-answer=\"no\">example.com.attacker.test</button><p id=\"result\" aria-live=\"polite\"></p></main>",
  "css": "body{margin:0;background:#20382a;color:#e6eedc;font:20px system-ui}main{padding:8%;}button{padding:1rem;margin:.5rem;}",
  "javascript": "document.querySelectorAll(\"button\").forEach(button => button.onclick = () => { document.querySelector(\"#result\").textContent = button.dataset.answer === \"yes\" ? \"Correct!\" : \"Check the actual domain at the end.\"; });",
